# Base de datos Postgres usada por docker-compose
POSTGRES_DB=agforest
POSTGRES_USER=agforest
POSTGRES_PASSWORD=agforest

# Backend
DATABASE_URL=postgresql+psycopg://agforest:agforest@postgres:5432/agforest
JWT_SECRET=change-this-super-secret-value
CORS_ORIGINS=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# IA. Déjalo vacío para modo demo/fallback local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Almacenamiento. local funciona sin configurar nada.
# Para Cloudinary: STORAGE_BACKEND=cloudinary y rellena credenciales.
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/app/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=agforest
